{
	servers {
		max_header_size 64KB
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

# Node-local production template for centralized DNS-01 certificates. The
# certificate directory must be mounted read-only into the Caddy container at
# /etc/sub2api-certs. The receiver atomically updates the current symlink.
#
# Keep this route policy explicit. This site is the API-only origin used by
# gateway clients; the web/panel origin (including /api/v1/*) is configured in
# its own site block and is intentionally not exposed by this transport host.
# Codex clients configured with the Sub2API host use root aliases (for example
# /images/generations), while OpenAI-compatible clients commonly use /v1
# equivalents. A terminal 404 is intentional outside this allowlist; it must
# not hide a supported gateway alias behind the edge.
(sub2api_proxy_no_store) {
	# Replace this example with the node's existing local upstream. Old-node
	# blue/green names and the Azure candidate's fixed app name are expected to
	# differ; certificate generation and edge policy must not.
	reverse_proxy sub2api:8080 {
		lb_try_duration 5s
		lb_try_interval 250ms
		flush_interval -1
		# This snippet is API-only: no-store intentionally covers health,
		# internal probes, and every gateway response. Do not reuse it for UI
		# or static assets, whose cache policy belongs to their own site block.
		header_down Cache-Control "no-store"

		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}

		transport http {
			read_timeout 1800s
			write_timeout 1800s
			keepalive 120s
			keepalive_idle_conns 256
			read_buffer 16KB
			write_buffer 16KB
			compression off
		}
		fail_duration 30s
		max_fails 3
		unhealthy_status 500 502 503 504
	}
}

api.turtleligpt.com {
	tls /etc/sub2api-certs/current/fullchain.pem /etc/sub2api-certs/current/privkey.pem {
		protocols tls1.2 tls1.3
		ciphers TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
	}

	encode {
		zstd
		gzip 6
		minimum_length 256
		match {
			header Content-Type text/css*
			header Content-Type text/csv*
			header Content-Type text/html*
			header Content-Type text/javascript*
			header Content-Type text/markdown*
			header Content-Type text/plain*
			header Content-Type text/xml*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xml*
			header Content-Type application/rss+xml*
			header Content-Type image/svg+xml*
		}
	}

	@large_multimodal_request_body path /v1/responses /v1/responses/* /responses /responses/* /backend-api/codex/responses /backend-api/codex/responses/* /v1/images/batches
	request_body @large_multimodal_request_body {
		max_size 128MB
	}
	@standard_request_body not path /v1/responses /v1/responses/* /responses /responses/* /backend-api/codex/responses /backend-api/codex/responses/* /v1/images/batches
	request_body @standard_request_body {
		max_size 16MB
	}

	log {
		output file /var/log/caddy/sub2api.log {
			roll_size 50mb
			roll_keep 10
			roll_keep_for 720h
		}
		format json
		level INFO
	}

	@health path /health
	handle @health {
		import sub2api_proxy_no_store
	}
	@internal_health path /internal/livez /internal/readyz
	handle @internal_health {
		import sub2api_proxy_no_store
	}

	# The signed payment callback is the only payment endpoint on the API host.
	@unified_payment_webhook {
		method POST
		path /api/v1/payment/webhook/unified
	}
	handle @unified_payment_webhook {
		import sub2api_proxy_no_store
	}

	# Keep this list aligned with RegisterGatewayRoutes. The broad versioned,
	# Codex, Antigravity, video, and custom-voice prefixes cover their registered
	# dynamic subroutes while the root aliases remain explicit.
	@openai_api path /v1/* /v1beta/* /responses /responses/* /alpha/search /models /messages/count_tokens /backend-api/codex/* /chat/completions /embeddings /images/generations /images/generations/* /images/edits /images/edits/* /images/tasks/* /videos /videos/* /tts /stt /custom-voices /custom-voices/* /realtime /web_search /x_search /antigravity/* /setup/status /api/event_logging/batch
	handle @openai_api {
		import sub2api_proxy_no_store
	}
	respond 404

	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}
