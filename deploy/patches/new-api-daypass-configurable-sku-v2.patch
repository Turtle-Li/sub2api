+func TestDaypassShopConfiguredSKUDoesNotInferEntitlementFromPrice(t *testing.T) {
+	// Given the same price as a legacy daily pass but an explicit weekly SKU.
+	input := DaypassShopInput{Instance: DaypassShopInstance, OrderID: 71, ProductID: 8, PriceFen: 600, Currency: "CNY", PaidAt: 1700000000,
+		SKUVersion: 2, DurationSeconds: 604800, Concurrency: 3}
+	// When the trusted machine request is parsed.
+	purchase, err := parseDaypassShopPurchase(input, 8, input.PaidAt)
+	// Then explicit attributes determine the entitlement and any positive authored price is accepted.
+	require.NoError(t, err)
+	assert.Equal(t, int64(604800), purchase.sku.duration)
+	assert.Equal(t, 3, purchase.sku.concurrency)
+	for _, mutate := range []func(*DaypassShopInput){
+		func(p *DaypassShopInput) { p.SKUVersion = 1 },
+		func(p *DaypassShopInput) { p.SKUVersion = 0 },
+		func(p *DaypassShopInput) { p.PriceFen = 0 },
+		func(p *DaypassShopInput) { p.DurationSeconds = 3600 },
+		func(p *DaypassShopInput) { p.Concurrency = 32 },
+	} {
+		invalid := input
+		mutate(&invalid)
+		_, err := parseDaypassShopPurchase(invalid, 8, input.PaidAt)
+		require.ErrorIs(t, err, ErrDaypassShopInvalid)
+	}
