diff --git b/model/daypass_shop_cards.go b/model/daypass_shop_cards.go
new file mode 100644
index 0000000..2d0f8ed
--- /dev/null
+++ b/model/daypass_shop_cards.go
@@ -0,0 +1,250 @@
+package model
+
+import (
+	"cmp"
+	"context"
+	"errors"
+	"math"
+	"slices"
+
+	"github.com/QuantumNous/new-api/common"
+	"gorm.io/gorm"
+	"gorm.io/gorm/logger"
+)
+
+const (
+	DaypassShopCardsVersion = 4
+	daypassCardNew          = "new"
+	daypassCardRenew        = "renew"
+)
+
+var ErrDaypassCardUnavailable = errors.New("daypass card cannot be renewed")
+
+type DaypassCardQuery struct {
+	Sub2UserID   int64   `json:"sub2_user_id"`
+	CardID       int64   `json:"card_id,omitempty"`
+	LegacyOrders []int64 `json:"legacy_order_ids,omitempty"`
+	IncludeBound bool    `json:"include_bound,omitempty"`
+}
+
+// The first purchase identifies the card even if a later order uses the same
+// credential. Only its last four characters leave the private delivery store.
+type DaypassShopCard struct {
+	CardID       int64  `json:"card_id"`
+	LastOrderID  int64  `json:"last_order_id"`
+	KeySuffix    string `json:"key_suffix"`
+	LastDays     int64  `json:"last_duration_days"`
+	ExpiresAt    int64  `json:"expires_at"`
+	NextStartsAt int64  `json:"next_starts_at,omitempty"`
+	Status       string `json:"status"`
+}
+
+func daypassUsesPaidWindows(version int) bool {
+	return version == DaypassShopRenewalVersion || version == DaypassShopCardsVersion
+}
+
+func validDaypassShopCardAction(input DaypassShopInput) bool {
+	if input.SKUVersion != DaypassShopCardsVersion {
+		return input.CardAction == "" && input.CardID == 0
+	}
+	switch input.CardAction {
+	case daypassCardNew:
+		return input.CardID == 0 && input.PriorOrderID == 0
+	case daypassCardRenew:
+		return input.CardID > 0 && input.CardID < input.OrderID && (input.PriorOrderID == 0 || input.PriorOrderID == input.CardID)
+	default:
+		return false
+	}
+}
+
+func daypassBoundShopBuyerTx(tx *gorm.DB, id int64) (int, error) {
+	var binding DaypassSub2User
+	found, err := daypassFind(tx.Where("sub2_user_id = ?", id), &binding)
+	if err != nil || !found {
+		return 0, err
+	}
+	var user User
+	found, err = daypassFind(tx.Where("id = ?", binding.UserID), &user)
+	if err != nil {
+		return 0, err
+	}
+	if !found || user.Status != common.UserStatusEnabled || user.GetSetting().BillingPreference != "subscription_only" {
+		return 0, ErrDaypassCardUnavailable
+	}
+	return user.Id, nil
+}
+
+func selectDaypassPurchaseKeyTx(tx *gorm.DB, input DaypassShopInput, now int64) (daypassRenewalSelection, error) {
+	if input.SKUVersion != DaypassShopCardsVersion {
+		return selectDaypassRenewalKeyTx(tx, input, now)
+	}
+	id, err := daypassBoundShopBuyerTx(tx, input.Sub2UserID)
+	if err != nil || input.CardAction == daypassCardNew {
+		return daypassRenewalSelection{userID: id}, err
+	}
+	var anchor DaypassShopOrder
+	found, err := daypassFind(tx.Where("id = ? AND product_id = ?", daypassShopReceiptID(input.Instance, input.CardID), input.ProductID), &anchor)
+	if err != nil {
+		return daypassRenewalSelection{}, err
+	}
+	if !found {
+		return daypassRenewalSelection{}, ErrDaypassCardUnavailable
+	}
+	selection, err := daypassExactCardTx(tx, &anchor, id, input.PriorOrderID == input.CardID, now)
+	if err != nil {
+		return selection, err
+	}
+	// Recheck the paid windows as well as token ownership. A stale selection
+	// may never fall back to a different token or a fresh issuance.
+	_, err = daypassCardMetadataTx(tx, &anchor, selection, now)
+	return selection, err
+}
+
+func daypassExactCardTx(tx *gorm.DB, anchor *DaypassShopOrder, userID int, legacyProof bool, now int64) (daypassRenewalSelection, error) {
+	selection := daypassRenewalSelection{userID: userID}
+	if anchor.UserID == nil || anchor.TokenID == nil {
+		return selection, ErrDaypassCardUnavailable
+	}
+	var err error
+	switch {
+	case anchor.RenewalTokenID != nil:
+		if userID == 0 || *anchor.UserID != userID {
+			return selection, ErrDaypassCardUnavailable
+		}
+		selection, err = daypassSelectRenewableAnchorTx(tx, selection, anchor, now)
+	case anchor.Status != "active":
+		return selection, ErrDaypassCardUnavailable
+	case userID != *anchor.UserID:
+		if !legacyProof {
+			return selection, ErrDaypassCardUnavailable
+		}
+		var claimed DaypassSub2User
+		found, lookup := daypassFind(tx.Where("user_id = ?", *anchor.UserID), &claimed)
+		if lookup != nil {
+			return selection, lookup
+		}
+		if found {
+			return selection, ErrDaypassCardUnavailable
+		}
+		selection, err = daypassSelectLegacyAnchorTx(tx, selection, anchor, now)
+	default:
+		selection, err = daypassSelectLegacyAnchorTx(tx, selection, anchor, now)
+	}
+	if errors.Is(err, gorm.ErrRecordNotFound) || errors.Is(err, ErrDaypassShopBinding) || errors.Is(err, ErrDaypassShopRevoked) {
+		return selection, ErrDaypassCardUnavailable
+	}
+	if err == nil && selection.token == nil {
+		return selection, ErrDaypassCardUnavailable
+	}
+	return selection, err
+}
+
+func ListDaypassShopCards(ctx context.Context, query DaypassCardQuery, productID, now int64) ([]DaypassShopCard, error) {
+	if query.Sub2UserID <= 0 || query.Sub2UserID > math.MaxInt32 || productID <= 0 || query.CardID < 0 || len(query.LegacyOrders) > 128 {
+		return nil, ErrDaypassShopInvalid
+	}
+	legacy := make(map[int64]bool, len(query.LegacyOrders))
+	keys := make([]string, 0, len(query.LegacyOrders))
+	for _, id := range query.LegacyOrders {
+		if id <= 0 || (query.CardID > 0 && query.CardID != id) {
+			return nil, ErrDaypassShopInvalid
+		}
+		legacy[id] = true
+		keys = append(keys, daypassShopReceiptID(DaypassShopInstance, id))
+	}
+	daypassShopMutex.Lock()
+	defer daypassShopMutex.Unlock()
+	cards := make([]DaypassShopCard, 0)
+	err := DB.WithContext(ctx).Session(&gorm.Session{Logger: DB.Logger.LogMode(logger.Silent)}).Transaction(func(tx *gorm.DB) error {
+		userID, err := daypassBoundShopBuyerTx(tx, query.Sub2UserID)
+		if err != nil {
+			return err
+		}
+		scope := tx.Where("id IN ? AND renewal_token_id IS NULL", keys)
+		if (query.IncludeBound || query.CardID != 0) && userID > 0 {
+			scope = scope.Or("user_id = ?", userID)
+		}
+		q := tx.Where("instance = ? AND product_id = ? AND token_id IS NOT NULL", DaypassShopInstance, productID).Where(scope)
+		if query.CardID != 0 {
+			q = q.Where("id = ?", daypassShopReceiptID(DaypassShopInstance, query.CardID))
+		}
+		var anchors []DaypassShopOrder
+		if err := q.Find(&anchors).Error; err != nil {
+			return err
+		}
+		for _, anchor := range anchors {
+			selection, err := daypassExactCardTx(tx, &anchor, userID, legacy[anchor.OrderID], now)
+			if err == nil {
+				var card DaypassShopCard
+				card, err = daypassCardMetadataTx(tx, &anchor, selection, now)
+				if err == nil {
+					cards = append(cards, card)
+				}
+			}
+			if err != nil && !errors.Is(err, ErrDaypassCardUnavailable) {
+				return err
+			}
+		}
+		return nil
+	})
+	return cards, err
+}
+
+type daypassCardWindow struct {
+	OrderID, PaidAt, StartsAt, ExpiresAt int64
+}
+
+func daypassCardMetadataTx(tx *gorm.DB, anchor *DaypassShopOrder, selection daypassRenewalSelection, now int64) (DaypassShopCard, error) {
+	token := selection.token
+	if len(token.Key) < 4 {
+		return DaypassShopCard{}, ErrDaypassCardUnavailable
+	}
+	var windows []daypassCardWindow
+	if selection.legacySub != nil {
+		windows = []daypassCardWindow{{anchor.OrderID, anchor.PaidAt, selection.legacySub.StartTime, anchor.ExpiresAt}}
+	} else {
+		receipts := tx.NamingStrategy.TableName("daypass_shop_order")
+		subs := tx.NamingStrategy.TableName("user_subscription")
+		err := tx.Table(receipts+" AS o").
+			Select("o.order_id, o.paid_at, o.renewal_starts_at AS starts_at, o.expires_at").
+			Joins("JOIN "+subs+" AS s ON s.id = o.subscription_id").
+			Where("o.renewal_token_id = ? AND o.user_id = ? AND o.status = ? AND o.instance = ? AND o.product_id = ?", token.Id, token.UserId, "active", anchor.Instance, anchor.ProductID).
+			Where("s.user_id = o.user_id AND s.source = ? AND s.plan_id = ? AND s.start_time = o.renewal_starts_at AND s.end_time = o.expires_at", "sub2_shop", 1).
+			Where("(s.status = ? OR (s.status = ? AND s.end_time <= ?)) AND s.amount_total = 0 AND s.allow_wallet_overflow = ?", "active", "expired", now, false).
+			Scan(&windows).Error
+		if err != nil {
+			return DaypassShopCard{}, err
+		}
+	}
+	if len(windows) == 0 {
+		return DaypassShopCard{}, ErrDaypassCardUnavailable
+	}
+	latest := slices.MaxFunc(windows, func(a, b daypassCardWindow) int {
+		if a.PaidAt != b.PaidAt {
+			return cmp.Compare(a.PaidAt, b.PaidAt)
+		}
+		return cmp.Compare(a.OrderID, b.OrderID)
+	})
+	days := int64(0)
+	switch latest.ExpiresAt - latest.StartsAt {
+	case daypassShopDaySecs:
+		days = 1
+	case DaypassShopWeekDays * daypassShopDaySecs:
+		days = DaypassShopWeekDays
+	}
+	card := DaypassShopCard{CardID: anchor.OrderID, LastOrderID: latest.OrderID, KeySuffix: token.Key[len(token.Key)-4:], LastDays: days, Status: "expired"}
+	for _, window := range windows {
+		card.ExpiresAt = max(card.ExpiresAt, window.ExpiresAt)
+		if window.StartsAt <= now && now < window.ExpiresAt && now < token.ExpiredTime {
+			card.Status = "active"
+		} else if window.StartsAt > now && window.StartsAt < token.ExpiredTime && (card.NextStartsAt == 0 || window.StartsAt < card.NextStartsAt) {
+			card.NextStartsAt = window.StartsAt
+		}
+	}
+	if card.Status == "active" {
+		card.NextStartsAt = 0
+	} else if card.NextStartsAt != 0 {
+		card.Status = "scheduled"
+	}
+	return card, nil
+}
diff --git b/model/daypass_shop_cards_test.go b/model/daypass_shop_cards_test.go
new file mode 100644
index 0000000..71d97ca
--- /dev/null
+++ b/model/daypass_shop_cards_test.go
@@ -0,0 +1,181 @@
+package model
+
+import (
+	"context"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func testDaypassShopCards(t *testing.T) {
+	ctx := context.Background()
+	now := time.Now().Unix()
+	const day = 86400
+	const productID, buyer = 8, 540
+	newCard := DaypassShopInput{
+		Instance: DaypassShopInstance, ProductID: productID, OrderID: 2001, PriceFen: 3000, Currency: "CNY",
+		PaidAt: now - 300, SKUVersion: DaypassShopCardsVersion, Sub2UserID: buyer, DurationSeconds: 7 * day,
+		Concurrency: 2, CardAction: daypassCardNew,
+	}
+	first, err := ProvisionDaypassShopOrder(ctx, newCard, productID, now)
+	require.NoError(t, err)
+	extra := newCard
+	extra.OrderID, extra.PaidAt, extra.DurationSeconds, extra.PriceFen, extra.Concurrency = 2002, now-100, day, 800, 3
+	second, err := ProvisionDaypassShopOrder(ctx, extra, productID, now)
+	require.NoError(t, err)
+	require.Equal(t, first.UserID, second.UserID)
+	require.NotEqual(t, first.TokenID, second.TokenID)
+	require.True(t, first.Key != second.Key)
+	require.Equal(t, extra.PaidAt, second.StartsAt)
+	replay, err := ProvisionDaypassShopOrder(ctx, extra, productID, now+1)
+	require.NoError(t, err)
+	require.Equal(t, second.TokenID, replay.TokenID)
+
+	// The earliest expiry belongs to the other card; billing still uses the
+	// subscription that actually admitted the first Key.
+	var firstToken Token
+	require.NoError(t, DB.First(&firstToken, *first.TokenID).Error)
+	grant, err := GetDaypassRelayEntitlement(ctx, &firstToken, now)
+	require.NoError(t, err)
+	require.Equal(t, 2, grant.Concurrency)
+	billed, err := PreConsumeDaypassSubscription("first-card", *first.UserID, grant.SubscriptionID, 17)
+	require.NoError(t, err)
+	require.Equal(t, *first.SubscriptionID, billed.UserSubscriptionId)
+	_, err = PreConsumeDaypassSubscription("first-card", *second.UserID, *second.SubscriptionID, 17)
+	require.ErrorIs(t, err, ErrDaypassShopBinding)
+
+	query := DaypassCardQuery{Sub2UserID: buyer, IncludeBound: true}
+	cards, err := ListDaypassShopCards(ctx, query, productID, now)
+	require.NoError(t, err)
+	require.Len(t, cards, 2)
+	for _, card := range cards {
+		require.Equal(t, "active", card.Status)
+		require.Len(t, card.KeySuffix, 4)
+	}
+	other := query
+	other.Sub2UserID++
+	other.CardID, other.LegacyOrders = first.CardID, []int64{first.CardID}
+	cards, err = ListDaypassShopCards(ctx, other, productID, now)
+	require.NoError(t, err)
+	require.Empty(t, cards)
+
+	extend := extra
+	extend.OrderID, extend.CardAction, extend.CardID = 2003, daypassCardRenew, first.CardID
+	renewed, err := ProvisionDaypassShopOrder(ctx, extend, productID, now)
+	require.NoError(t, err)
+	require.Equal(t, first.TokenID, renewed.TokenID)
+	require.True(t, first.Key == renewed.Key)
+	require.Equal(t, first.ExpiresAt, renewed.StartsAt)
+	changed := extend
+	changed.CardID = second.CardID
+	_, err = ProvisionDaypassShopOrder(ctx, changed, productID, now)
+	require.ErrorIs(t, err, ErrDaypassShopBinding)
+	changed.OrderID, changed.Sub2UserID = 2004, other.Sub2UserID
+	_, err = ProvisionDaypassShopOrder(ctx, changed, productID, now)
+	require.ErrorIs(t, err, ErrDaypassCardUnavailable)
+
+	// Both expired cards are still independently selectable. Restore the
+	// day card and verify the other card's entitlement never changes.
+	later := renewed.ExpiresAt + 60
+	_, err = CleanupDaypassTokens(ctx, later, func(int) bool { return false })
+	require.NoError(t, err)
+	cards, err = ListDaypassShopCards(ctx, query, productID, later)
+	require.NoError(t, err)
+	require.Len(t, cards, 2)
+	for _, card := range cards {
+		require.Equal(t, "expired", card.Status)
+	}
+	restore := extra
+	restore.OrderID, restore.PaidAt, restore.CardAction, restore.CardID = 2005, later, daypassCardRenew, second.CardID
+	restored, err := ProvisionDaypassShopOrder(ctx, restore, productID, later)
+	require.NoError(t, err)
+	require.True(t, restored.Key == second.Key)
+	require.Equal(t, later, restored.StartsAt)
+	require.NoError(t, DB.First(&firstToken, *first.TokenID).Error)
+	require.Equal(t, renewed.ExpiresAt, firstToken.ExpiredTime)
+	_, err = GetDaypassRelayEntitlement(ctx, &firstToken, later)
+	require.ErrorIs(t, err, ErrDaypassShopExpired)
+
+	queued := restore
+	queued.OrderID, queued.PaidAt = 2006, later+1
+	future, err := ProvisionDaypassShopOrder(ctx, queued, productID, later+1)
+	require.NoError(t, err)
+	require.Equal(t, restored.ExpiresAt, future.StartsAt)
+	_, err = RevokeDaypassShopOrder(ctx, restore, productID, later)
+	require.NoError(t, err)
+	var secondToken Token
+	require.NoError(t, DB.First(&secondToken, *second.TokenID).Error)
+	require.Equal(t, future.ExpiresAt, secondToken.ExpiredTime)
+	cards, err = ListDaypassShopCards(ctx, DaypassCardQuery{Sub2UserID: buyer, CardID: second.CardID}, productID, later+1)
+	require.NoError(t, err)
+	require.Len(t, cards, 1)
+	require.Equal(t, "scheduled", cards[0].Status)
+	require.Equal(t, future.StartsAt, cards[0].NextStartsAt)
+	_, err = GetDaypassRelayEntitlement(ctx, &secondToken, later+1)
+	require.ErrorIs(t, err, ErrDaypassShopExpired)
+	_, err = RevokeDaypassShopOrder(ctx, queued, productID, later+1)
+	require.NoError(t, err)
+	require.NoError(t, DB.First(&secondToken, *second.TokenID).Error)
+	require.Equal(t, second.ExpiresAt, secondToken.ExpiredTime)
+	require.NoError(t, DeleteDaypassKey(ctx, *second.TokenID, later))
+	restore.OrderID = 2007
+	_, err = ProvisionDaypassShopOrder(ctx, restore, productID, later)
+	require.ErrorIs(t, err, ErrDaypassCardUnavailable)
+	cards, err = ListDaypassShopCards(ctx, query, productID, later)
+	require.NoError(t, err)
+	require.Len(t, cards, 1)
+	require.Equal(t, first.CardID, cards[0].CardID)
+	require.True(t, strings.HasSuffix(first.Key, cards[0].KeySuffix))
+
+	// A checkout that began before v4 can still finish during cutover. Its
+	// implicit v3 flow must leave cards that were explicitly bought alone.
+	legacy := extra
+	legacy.OrderID, legacy.PaidAt, legacy.SKUVersion, legacy.CardAction = 2010, later, DaypassShopRenewalVersion, ""
+	canonical, err := ProvisionDaypassShopOrder(ctx, legacy, productID, later)
+	require.NoError(t, err)
+	require.Equal(t, first.UserID, canonical.UserID)
+	require.True(t, canonical.Key != first.Key && canonical.Key != second.Key)
+	legacy.OrderID++
+	continued, err := ProvisionDaypassShopOrder(ctx, legacy, productID, later)
+	require.NoError(t, err)
+	require.Equal(t, canonical.TokenID, continued.TokenID)
+	require.NoError(t, DB.First(&firstToken, *first.TokenID).Error)
+	require.Equal(t, renewed.ExpiresAt, firstToken.ExpiredTime)
+
+	// A days label may be absent after a historical administrative extension.
+	// Its original paid order still identifies the SKU on the sender, and
+	// the receiver uses the real (extended) expiry when renewing.
+	unlinked := DaypassShopInput{Instance: DaypassShopInstance, ProductID: productID, OrderID: 2012, PriceFen: 600, Currency: "CNY", PaidAt: now}
+	old, err := ProvisionDaypassShopOrder(ctx, unlinked, productID, now)
+	require.NoError(t, err)
+	extended, err := RenewDaypassKey(ctx, *old.TokenID, 3600, now)
+	require.NoError(t, err)
+	oldQuery := DaypassCardQuery{Sub2UserID: buyer + 2, LegacyOrders: []int64{unlinked.OrderID}}
+	cards, err = ListDaypassShopCards(ctx, oldQuery, productID, now)
+	require.NoError(t, err)
+	require.Len(t, cards, 1)
+	require.Equal(t, unlinked.OrderID, cards[0].LastOrderID)
+	require.Zero(t, cards[0].LastDays)
+	recoverOld := extend
+	recoverOld.Sub2UserID, recoverOld.PriorOrderID = oldQuery.Sub2UserID, unlinked.OrderID
+	recoverOld.OrderID, recoverOld.CardID = 2013, unlinked.OrderID
+	renewOld, err := ProvisionDaypassShopOrder(ctx, recoverOld, productID, now)
+	require.NoError(t, err)
+	require.Equal(t, extended.Token.ExpiredTime, renewOld.StartsAt)
+	require.True(t, old.Key == renewOld.Key)
+
+	boundV2 := extra
+	boundV2.OrderID, boundV2.Sub2UserID, boundV2.SKUVersion = 2014, buyer, 2
+	boundV2.PaidAt, boundV2.CardAction = later, ""
+	older, err := ProvisionDaypassShopOrder(ctx, boundV2, productID, later)
+	require.NoError(t, err)
+	require.Equal(t, canonical.UserID, older.UserID)
+	var oldBoundToken Token
+	require.NoError(t, DB.First(&oldBoundToken, *older.TokenID).Error)
+	oldGrant, err := GetDaypassRelayEntitlement(ctx, &oldBoundToken, later)
+	require.NoError(t, err)
+	require.Equal(t, *older.SubscriptionID, oldGrant.SubscriptionID)
+	require.Equal(t, 3, oldGrant.Concurrency)
+}
