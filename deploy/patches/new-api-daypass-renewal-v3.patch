+++ b/model/daypass_shop_renewal_test.go
@@ -0,0 +1,264 @@
+package model
+
+import (
+	"context"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+// The pre-renewal receipt schema retains its unique native IDs and digest.
+type daypassShopReceiptBeforeRenewal struct {
+	ID             string `gorm:"primaryKey;size:64"`
+	Instance       string `gorm:"size:64;not null"`
+	OrderID        int64  `gorm:"not null"`
+	ProductID      int64  `gorm:"not null"`
+	BindingDigest  string `gorm:"size:64;not null"`
+	UserID         *int   `gorm:"index:idx_daypass_shop_orders_user_id"`
+	TokenID        *int   `gorm:"uniqueIndex"`
+	SubscriptionID *int   `gorm:"uniqueIndex"`
+	PaidAt         int64  `gorm:"not null"`
+	ExpiresAt      int64  `gorm:"not null;index"`
+	Status         string `gorm:"size:16;not null"`
+	CreatedAt      int64  `gorm:"not null;index"`
+}
+
+func testDaypassShopRenewalMigration(t *testing.T, db *gorm.DB) {
+	t.Helper()
+	table := db.NamingStrategy.TableName("daypass_shop_order")
+	require.NoError(t, db.Table(table).AutoMigrate(&daypassShopReceiptBeforeRenewal{}))
+	userID, tokenID, subscriptionID := 9000, 9001, 9002
+	legacy := daypassShopReceiptBeforeRenewal{
+		ID: "prior-receipt", Instance: DaypassShopInstance, OrderID: 9003, ProductID: 8, BindingDigest: "original-digest",
+		UserID: &userID, TokenID: &tokenID, SubscriptionID: &subscriptionID, PaidAt: 1700000000,
+		ExpiresAt: 1700086400, Status: "active", CreatedAt: 1700000000,
+	}
+	require.NoError(t, db.Table(table).Create(&legacy).Error)
+	for range 2 {
+		require.NoError(t, db.AutoMigrate(&DaypassShopOrder{}, &DaypassSub2User{}))
+		var row DaypassShopOrder
+		require.NoError(t, db.First(&row, "id = ?", legacy.ID).Error)
+		require.Equal(t, legacy.BindingDigest, row.BindingDigest)
+		require.Equal(t, legacy.TokenID, row.TokenID)
+		require.Equal(t, legacy.SubscriptionID, row.SubscriptionID)
+		require.Equal(t, legacy.ExpiresAt, row.ExpiresAt)
+		require.Nil(t, row.RenewalTokenID)
+		require.True(t, db.Migrator().HasIndex(&DaypassShopOrder{}, "TokenID"))
+	}
+	var version string
+	query := "SELECT VERSION()"
+	if common.UsingMainDatabase(common.DatabaseTypeSQLite) {
+		query = "SELECT sqlite_version()"
+	}
+	require.NoError(t, db.Raw(query).Scan(&version).Error)
+	t.Logf("database version: %s", version)
+	require.NoError(t, db.Delete(&DaypassShopOrder{}, "id = ?", legacy.ID).Error)
+}
+
+func testDaypassShopRenewableKey(t *testing.T) {
+	t.Helper()
+	ctx := context.Background()
+	now := time.Now().Unix()
+	const productID int64 = 8
+	legacy := DaypassShopInput{Instance: DaypassShopInstance, OrderID: 1001, ProductID: productID,
+		PriceFen: 600, Currency: "CNY", PaidAt: now - 3*86400}
+	first, err := ProvisionDaypassShopOrder(ctx, legacy, productID, legacy.PaidAt+1)
+	require.NoError(t, err)
+	_, err = CleanupDaypassTokens(ctx, now, func(int) bool { return false })
+	require.NoError(t, err)
+	key := strings.TrimPrefix(first.Key, "sk-")
+	var priorToken Token
+	require.ErrorIs(t, DB.First(&priorToken, *first.TokenID).Error, gorm.ErrRecordNotFound)
+
+	day := DaypassShopInput{Instance: DaypassShopInstance, OrderID: 1002, ProductID: productID,
+		PriceFen: 600, Currency: "CNY", PaidAt: now - 10, SKUVersion: DaypassShopRenewalVersion, DurationSeconds: 86400,
+		Concurrency: 2, Sub2UserID: 510, PriorOrderID: legacy.OrderID}
+	renewed, err := ProvisionDaypassShopOrder(ctx, day, productID, now)
+	require.NoError(t, err)
+	require.True(t, first.Key == renewed.Key, "purchase must restore the original credential")
+	require.Equal(t, *first.TokenID, *renewed.TokenID)
+	require.Equal(t, day.PaidAt+86400, renewed.ExpiresAt)
+	_, err = ValidateUserToken(key)
+	require.NoError(t, err)
+
+	week := day
+	week.OrderID, week.PaidAt, week.DurationSeconds, week.Concurrency = 1003, now, 7*86400, 3
+	extension, err := ProvisionDaypassShopOrder(ctx, week, productID, now)
+	require.NoError(t, err)
+	require.True(t, renewed.Key == extension.Key)
+	require.Equal(t, renewed.ExpiresAt+7*86400, extension.ExpiresAt)
+	retry, err := ProvisionDaypassShopOrder(ctx, week, productID, now+1)
+	require.NoError(t, err)
+	require.Equal(t, extension.ExpiresAt, retry.ExpiresAt)
+
+	var token Token
+	require.NoError(t, DB.First(&token, *first.TokenID).Error)
+	tier, err := DaypassRelayConcurrency(ctx, &token, now)
+	require.NoError(t, err)
+	require.Equal(t, 2, tier)
+	tier, err = DaypassRelayConcurrency(ctx, &token, renewed.ExpiresAt)
+	require.NoError(t, err)
+	require.Equal(t, 3, tier)
+
+	revoked, err := RevokeDaypassShopOrder(ctx, day, productID, now+1)
+	require.NoError(t, err)
+	require.Empty(t, revoked.Key)
+	_, err = DaypassRelayConcurrency(ctx, &token, now+1)
+	require.ErrorIs(t, err, ErrDaypassShopExpired)
+	tier, err = DaypassRelayConcurrency(ctx, &token, renewed.ExpiresAt)
+	require.NoError(t, err)
+	require.Equal(t, 3, tier)
+	_, err = ProvisionDaypassShopOrder(ctx, day, productID, now+1)
+	require.ErrorIs(t, err, ErrDaypassShopRevoked)
+
+	_, err = CleanupDaypassTokens(ctx, extension.ExpiresAt+3601, func(int) bool { return false })
+	require.NoError(t, err)
+	require.NoError(t, DB.First(&Token{}, *first.TokenID).Error, "cleanup must retain the reusable key")
+
+	third := day
+	third.OrderID, third.PaidAt, third.PriorOrderID = 1004, extension.ExpiresAt+3*86400, 0
+	restored, err := ProvisionDaypassShopOrder(ctx, third, productID, third.PaidAt+1)
+	require.NoError(t, err)
+	require.True(t, restored.Key == first.Key, "subsequent renewal needs only the bound buyer")
+	require.Equal(t, third.PaidAt, restored.StartsAt)
+	require.Equal(t, third.PaidAt+86400, restored.ExpiresAt)
+}
+
+func testDaypassShopRenewalSafety(t *testing.T) {
+	t.Helper()
+	ctx := context.Background()
+	now := time.Now().Unix()
+	const productID int64 = 8
+	buyer := DaypassShopInput{Instance: DaypassShopInstance, OrderID: 1100, ProductID: productID,
+		PriceFen: 600, Currency: "CNY", PaidAt: now - 100, SKUVersion: 2, DurationSeconds: 86400,
+		Concurrency: 2, Sub2UserID: 520}
+	first, err := ProvisionDaypassShopOrder(ctx, buyer, productID, now)
+	require.NoError(t, err)
+	manual, err := IssueDaypassManual(ctx, 9, DaypassManualInput{
+		RequestID: uuid.NewString(), Name: "manual gift", DurationSeconds: 7200, Concurrency: 3, Sub2UserID: buyer.Sub2UserID,
+	}, now)
+	require.NoError(t, err)
+	input := buyer
+	input.SKUVersion, input.OrderID, input.PaidAt = DaypassShopRenewalVersion, 1101, now
+	next, err := ProvisionDaypassShopOrder(ctx, input, productID, now)
+	require.NoError(t, err)
+	require.True(t, next.Key == first.Key && next.Key != manual.Key, "only the prior shop credential is renewed")
+	require.Equal(t, first.ExpiresAt, next.StartsAt)
+	replay, err := ProvisionDaypassShopOrder(ctx, buyer, productID, now)
+	require.NoError(t, err)
+	require.True(t, replay.Key == first.Key)
+
+	foreign := input
+	foreign.Sub2UserID, foreign.OrderID, foreign.PriorOrderID = 521, 1102, buyer.OrderID
+	_, err = ProvisionDaypassShopOrder(ctx, foreign, productID, now)
+	require.ErrorIs(t, err, ErrDaypassShopBinding)
+	_, err = RevokeDaypassShopOrder(ctx, buyer, productID, now)
+	require.NoError(t, err)
+	_, err = ProvisionDaypassShopOrder(ctx, input, productID, now)
+	require.NoError(t, err, "refunding an adopted legacy order must not revoke the renewal")
+
+	tokenID := *first.TokenID
+	require.NoError(t, SetDaypassKeyStatus(ctx, tokenID, common.TokenStatusDisabled, now))
+	input.OrderID++
+	_, err = ProvisionDaypassShopOrder(ctx, input, productID, now)
+	require.ErrorIs(t, err, ErrDaypassShopRevoked)
+	require.NoError(t, DeleteDaypassKey(ctx, tokenID, now))
+	input.OrderID++
+	replacement, err := ProvisionDaypassShopOrder(ctx, input, productID, now)
+	require.NoError(t, err)
+	require.True(t, replacement.Key != first.Key, "explicit deletion must not restore the old credential")
+	require.ErrorIs(t, DB.First(&Token{}, tokenID).Error, gorm.ErrRecordNotFound)
+	_, err = ProvisionDaypassShopOrder(ctx, buyer, productID, now)
+	require.ErrorIs(t, err, ErrDaypassShopRevoked)
+}
+
+func testDaypassShopRenewalAdoptsIntoExistingBinding(t *testing.T) {
+	t.Helper()
+	ctx := context.Background()
+	now := time.Now().Unix()
+	const productID int64 = 8
+	const buyerID int64 = 525
+	legacy := DaypassShopInput{Instance: DaypassShopInstance, OrderID: 1150, ProductID: productID,
+		PriceFen: 800, Currency: "CNY", PaidAt: now - 1800}
+	old, err := ProvisionDaypassShopOrder(ctx, legacy, productID, now)
+	require.NoError(t, err)
+	gift := DaypassManualInput{
+		RequestID: uuid.NewString(), Name: "manual gift", DurationSeconds: 7200, Concurrency: 3, Sub2UserID: buyerID,
+	}
+	manual, err := IssueDaypassManual(ctx, 9, gift, now)
+	require.NoError(t, err)
+	require.NotEqual(t, *old.UserID, manual.UserID)
+	renewal := DaypassShopInput{Instance: DaypassShopInstance, OrderID: 1151, ProductID: productID,
+		PriceFen: 600, Currency: "CNY", PaidAt: now, SKUVersion: DaypassShopRenewalVersion,
+		DurationSeconds: 86400, Concurrency: 2, Sub2UserID: buyerID, PriorOrderID: legacy.OrderID}
+	grant, err := ProvisionDaypassShopOrder(ctx, renewal, productID, now)
+	require.NoError(t, err)
+	require.True(t, grant.Key == old.Key && grant.Key != manual.Key)
+	require.Equal(t, manual.UserID, *grant.UserID)
+	require.Equal(t, old.ExpiresAt, grant.StartsAt)
+	var token Token
+	var original UserSubscription
+	require.NoError(t, DB.First(&token, *old.TokenID).Error)
+	require.NoError(t, DB.First(&original, *old.SubscriptionID).Error)
+	require.Equal(t, manual.UserID, token.UserId)
+	require.Equal(t, manual.UserID, original.UserId)
+	require.Equal(t, old.ExpiresAt, original.EndTime)
+	tier, err := DaypassRelayConcurrency(ctx, &token, now)
+	require.NoError(t, err)
+	require.Equal(t, 3, tier)
+	tier, err = DaypassRelayConcurrency(ctx, &token, grant.StartsAt)
+	require.NoError(t, err)
+	require.Equal(t, 2, tier)
+	unchanged, err := IssueDaypassManual(ctx, 9, gift, now+1)
+	require.NoError(t, err)
+	require.Equal(t, manual.UserID, unchanged.UserID)
+	require.Equal(t, manual.ExpiresAt, unchanged.ExpiresAt)
+	require.True(t, manual.Key == unchanged.Key && grant.Key != unchanged.Key)
+}
+
+func testDaypassShopRenewalConcurrent(t *testing.T) {
+	t.Helper()
+	ctx := context.Background()
+	now := time.Now().Unix()
+	const productID int64 = 8
+	input := DaypassShopInput{Instance: DaypassShopInstance, OrderID: 1200, ProductID: productID,
+		PriceFen: 600, Currency: "CNY", PaidAt: now, SKUVersion: DaypassShopRenewalVersion, DurationSeconds: 86400,
+		Concurrency: 2, Sub2UserID: 530}
+	type response struct {
+		grant *DaypassShopResult
+		err   error
+	}
+	results := make(chan response, 4)
+	for _, offset := range []int64{0, 1, 0, 1} {
+		order := input
+		order.OrderID += offset
+		go func() {
+			grant, err := ProvisionDaypassShopOrder(ctx, order, productID, now)
+			results <- response{grant, err}
+		}()
+	}
+	grants := make(map[int64]*DaypassShopResult)
+	for range 4 {
+		result := <-results
+		require.NoError(t, result.err)
+		if prior := grants[result.grant.OrderID]; prior != nil {
+			require.True(t, prior.Key == result.grant.Key)
+			require.Equal(t, prior.ExpiresAt, result.grant.ExpiresAt)
+		}
+		grants[result.grant.OrderID] = result.grant
+	}
+	first, second := grants[1200], grants[1201]
+	require.True(t, first.Key == second.Key)
+	require.Equal(t, now+2*86400, max(first.ExpiresAt, second.ExpiresAt))
+	var count int64
+	require.NoError(t, DB.Model(&DaypassShopOrder{}).Where("renewal_token_id = ?", *first.TokenID).Count(&count).Error)
+	require.EqualValues(t, 2, count)
+	require.NoError(t, DB.Model(&Option{}).Where(commonKeyCol+" = ?", daypassConcurrencyPrefix+strconv.Itoa(*first.TokenID)).Count(&count).Error)
+	require.Zero(t, count, "tier follows receipts without an administrator override")
+}
diff --git a/model/daypass_shop_selection.go b/model/daypass_shop_selection.go
new file mode 100644
--- /dev/null
+++ b/model/daypass_shop_selection.go
@@ -0,0 +1,157 @@
+package model
+
+import (
+	"github.com/QuantumNous/new-api/common"
+	"gorm.io/gorm"
+)
+
+type daypassRenewalSelection struct {
+	token     *Token
+	anchor    *DaypassShopOrder
+	legacySub *UserSubscription
+	userID    int
+}
+
+// Only shop receipts can identify a key. Existing bindings take precedence;
+// the optional order ID is a one-time bridge for pre-binding purchases.
+func selectDaypassRenewalKeyTx(tx *gorm.DB, input DaypassShopInput, now int64) (daypassRenewalSelection, error) {
+	var binding DaypassSub2User
+	found, err := daypassFind(tx.Where("sub2_user_id = ?", input.Sub2UserID), &binding)
+	if err != nil {
+		return daypassRenewalSelection{}, err
+	}
+	if found {
+		account := daypassSub2Account{UserID: input.Sub2UserID, Username: input.Sub2Username}
+		user, err := EnsureDaypassSub2UserTx(tx, account, now)
+		if err != nil {
+			return daypassRenewalSelection{}, err
+		}
+		if user.GetSetting().BillingPreference != "subscription_only" {
+			return daypassRenewalSelection{}, ErrDaypassShopBinding
+		}
+		selection := daypassRenewalSelection{userID: user.Id}
+		var anchor DaypassShopOrder
+		// New replacements have higher token IDs even if two paid orders
+		// arrive out of order in the same second.
+		found, err := daypassFind(tx.Where("user_id = ? AND instance = ? AND product_id = ? AND token_id IS NOT NULL AND renewal_token_id IS NOT NULL",
+			user.Id, input.Instance, input.ProductID).Order("token_id DESC"), &anchor)
+		if err != nil {
+			return selection, err
+		}
+		if found {
+			return daypassSelectRenewableAnchorTx(tx, selection, &anchor, now)
+		}
+		found, err = daypassFind(tx.Where("user_id = ? AND instance = ? AND product_id = ? AND token_id IS NOT NULL AND status = ?",
+			user.Id, input.Instance, input.ProductID, "active").Order("expires_at DESC, order_id DESC"), &anchor)
+		if err != nil {
+			return selection, err
+		}
+		if found {
+			return daypassSelectLegacyAnchorTx(tx, selection, &anchor, now)
+		}
+		if input.PriorOrderID != 0 {
+			return daypassSelectPriorOrderTx(tx, selection, input, now)
+		}
+		return selection, nil
+	}
+	selection := daypassRenewalSelection{}
+	if input.PriorOrderID == 0 {
+		return selection, nil
+	}
+	return daypassSelectPriorOrderTx(tx, selection, input, now)
+}
+
+func daypassSelectPriorOrderTx(tx *gorm.DB, selection daypassRenewalSelection, input DaypassShopInput, now int64) (daypassRenewalSelection, error) {
+	var anchor DaypassShopOrder
+	found, err := daypassFind(tx.Where("id = ? AND product_id = ?", daypassShopReceiptID(input.Instance, input.PriorOrderID), input.ProductID), &anchor)
+	if err != nil || !found || anchor.Status != "active" || anchor.TokenID == nil || anchor.UserID == nil {
+		return selection, err
+	}
+	if anchor.RenewalTokenID != nil {
+		return selection, ErrDaypassShopBinding
+	}
+	if *anchor.UserID != selection.userID {
+		var other DaypassSub2User
+		claimed, err := daypassFind(tx.Where("user_id = ?", *anchor.UserID), &other)
+		if err != nil {
+			return selection, err
+		}
+		if claimed {
+			return selection, ErrDaypassShopBinding
+		}
+	}
+	return daypassSelectLegacyAnchorTx(tx, selection, &anchor, now)
+}
+
+func daypassSelectRenewableAnchorTx(tx *gorm.DB, selection daypassRenewalSelection, anchor *DaypassShopOrder, now int64) (daypassRenewalSelection, error) {
+	var token Token
+	found, err := daypassFind(tx.Where("id = ?", *anchor.TokenID), &token)
+	if err != nil || !found {
+		// Explicitly deleted keys are never restored. A later purchase may
+		// get a fresh credential under the same buyer.
+		return selection, err
+	}
+	if token.UserId != selection.userID || !isDaypassShopToken(&token) || *anchor.RenewalTokenID != token.Id {
+		return selection, ErrDaypassShopBinding
+	}
+	if token.Status == common.TokenStatusDisabled {
+		return selection, ErrDaypassShopRevoked
+	}
+	if !daypassTokenCanRenew(&token, now) {
+		return selection, ErrDaypassShopBinding
+	}
+	selection.token = &token
+	return selection, nil
+}
+
+func daypassSelectLegacyAnchorTx(tx *gorm.DB, selection daypassRenewalSelection, anchor *DaypassShopOrder, now int64) (daypassRenewalSelection, error) {
+	var token Token
+	// Legacy expiry cleanup used soft deletion. Explicit day-pass deletion
+	// changes the receipt status; revoked receipts are never passed here.
+	found, err := daypassFind(tx.Unscoped().Where("id = ?", *anchor.TokenID), &token)
+	if err != nil || !found {
+		return selection, err
+	}
+	if token.UserId != *anchor.UserID || !isDaypassShopToken(&token) || token.ExpiredTime != anchor.ExpiresAt || anchor.SubscriptionID == nil {
+		return selection, ErrDaypassShopBinding
+	}
+	var oldUser User
+	if err := tx.First(&oldUser, token.UserId).Error; err != nil {
+		return selection, err
+	}
+	if oldUser.Status != common.UserStatusEnabled || oldUser.GetSetting().BillingPreference != "subscription_only" {
+		return selection, ErrDaypassShopRevoked
+	}
+	var sub UserSubscription
+	if err := tx.First(&sub, *anchor.SubscriptionID).Error; err != nil {
+		return selection, err
+	}
+	if sub.UserId != token.UserId || sub.EndTime != anchor.ExpiresAt || sub.Source != "sub2_shop" || sub.PlanId != 1 ||
+		sub.AmountTotal != 0 || sub.AllowWalletOverflow || sub.StartTime <= 0 || sub.StartTime >= anchor.ExpiresAt {
+		return selection, ErrDaypassShopBinding
+	}
+	if sub.Status != "active" && (sub.Status != "expired" || sub.EndTime > now) {
+		return selection, ErrDaypassShopRevoked
+	}
+	if token.Status == common.TokenStatusDisabled {
+		return selection, ErrDaypassShopRevoked
+	}
+	if token.DeletedAt.Valid && token.DeletedAt.Time.Unix()-daypassExpiryCleanupDelaySecs < token.ExpiredTime {
+		return selection, ErrDaypassShopRevoked
+	}
+	if !daypassTokenCanRenew(&token, now) {
+		return selection, ErrDaypassShopBinding
+	}
+	selection.token, selection.anchor, selection.legacySub = &token, anchor, &sub
+	return selection, nil
+}
+
+func daypassFind[T any](query *gorm.DB, target *T) (bool, error) {
+	result := lockForUpdate(query).Limit(1).Find(target)
+	return result.RowsAffected == 1, result.Error
+}
+
+func daypassTokenCanRenew(token *Token, now int64) bool {
+	return token.Status == common.TokenStatusEnabled ||
+		token.Status == common.TokenStatusExpired && token.ExpiredTime <= now
+}
