@@ -0,0 +1,42 @@
+package model
+
+import (
+	"context"
+
+	"github.com/QuantumNous/new-api/common"
+)
+
+type daypassShopAccess struct {
+	Managed bool
+	Tier    int
+}
+
+// DaypassRelayConcurrency returns the tier of the paid window covering now.
+// Future orders and refunded windows cannot authorize relay traffic, even
+// though the reusable token's outer expiry may be further in the future.
+func DaypassRelayConcurrency(ctx context.Context, token *Token, now int64) (int, error) {
+	var access daypassShopAccess
+	db := DB.WithContext(ctx)
+	paid := db.Model(&DaypassShopOrder{}).Select("renewal_tier").
+		Where("renewal_token_id = ? AND user_id = ? AND status = ? AND renewal_starts_at <= ? AND expires_at > ?",
+			token.Id, token.UserId, "active", now, now).
+		Where("subscription_id IN (?)", db.Model(&UserSubscription{}).Select("id").
+			Where("user_id = ? AND plan_id = ? AND source = ? AND status = ? AND start_time <= ? AND end_time > ?",
+				token.UserId, 1, "sub2_shop", "active", now, now)).
+		Order("renewal_starts_at DESC, order_id DESC").Limit(1)
+	anchor := db.Model(&DaypassShopOrder{}).Select("1").
+		Where("token_id = ? AND renewal_token_id = ?", token.Id, token.Id)
+	if err := db.Raw("SELECT EXISTS (?) AS managed, COALESCE((?), 0) AS tier", anchor, paid).Scan(&access).Error; err != nil {
+		return 0, err
+	}
+	if !access.Managed {
+		return GetDaypassTokenConcurrency(token.Id), nil
+	}
+	if access.Tier <= 0 || access.Tier > DaypassMaxConcurrency || token.Status != common.TokenStatusEnabled || !isDaypassShopToken(token) {
+		return 0, ErrDaypassShopExpired
+	}
+	if limit := daypassTokenConcurrencyOverride(token.Id); limit > 0 {
+		return limit, nil
+	}
+	return access.Tier, nil
+}
