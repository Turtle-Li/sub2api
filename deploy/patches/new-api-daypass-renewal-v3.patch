diff --git a/model/daypass_key_status.go b/model/daypass_key_status.go
new file mode 100644
--- /dev/null
+++ b/model/daypass_key_status.go
@@ -0,0 +1,105 @@
+package model
+
+import (
+	"context"
+	"errors"
+	"strconv"
+
+	"github.com/QuantumNous/new-api/common"
+	"gorm.io/gorm"
+)
+
+// SetDaypassKeyStatus flips only the token gate; the receipt term and
+// subscription are untouched so a disabled key can be re-enabled.
+func SetDaypassKeyStatus(ctx context.Context, tokenID, status int, now int64) error {
+	if tokenID <= 0 || (status != common.TokenStatusEnabled && status != common.TokenStatusDisabled) {
+		return ErrDaypassShopInvalid
+	}
+	daypassShopMutex.Lock()
+	defer daypassShopMutex.Unlock()
+	return DB.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		receipt, err := resolveDaypassKeyReceiptTx(tx, tokenID, true)
+		if err != nil {
+			return err
+		}
+		if !receipt.Renewable && receipt.Status != "active" {
+			return ErrDaypassShopRevoked
+		}
+		var token Token
+		if err := tx.First(&token, tokenID).Error; err != nil {
+			if errors.Is(err, gorm.ErrRecordNotFound) {
+				return ErrDaypassShopRevoked
+			}
+			return err
+		}
+		if !receipt.Renewable && status == common.TokenStatusEnabled && token.ExpiredTime > 0 && token.ExpiredTime <= now {
+			return ErrDaypassShopExpired
+		}
+		if err := invalidateTokenCacheForMutation(token.Key); err != nil {
+			return err
+		}
+		return tx.Model(&Token{}).Where("id = ?", tokenID).Update("status", status).Error
+	})
+}
+
+// DeleteDaypassKey revokes the receipt and soft-deletes the token so the list
+// shrinks immediately while paid/manual evidence stays intact.
+func DeleteDaypassKey(ctx context.Context, tokenID int, now int64) error {
+	if tokenID <= 0 {
+		return ErrDaypassShopInvalid
+	}
+	daypassShopMutex.Lock()
+	defer daypassShopMutex.Unlock()
+	optionKey := daypassConcurrencyPrefix + strconv.Itoa(tokenID)
+	err := DB.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		receipt, err := resolveDaypassKeyReceiptTx(tx, tokenID, true)
+		if err != nil {
+			return err
+		}
+		var token Token
+		if err := tx.Unscoped().First(&token, tokenID).Error; err != nil {
+			if errors.Is(err, gorm.ErrRecordNotFound) {
+				return nil
+			}
+			return err
+		}
+		if !token.DeletedAt.Valid {
+			if err := revokeDaypassTokenTx(tx, tokenID); err != nil {
+				return err
+			}
+			if err := tx.Delete(&token).Error; err != nil {
+				return err
+			}
+		}
+		if receipt.Renewable {
+			rows := tx.Model(&DaypassShopOrder{}).Where("renewal_token_id = ?", tokenID)
+			subscriptions := tx.Model(&DaypassShopOrder{}).Select("subscription_id").
+				Where("renewal_token_id = ? AND subscription_id IS NOT NULL", tokenID)
+			if err := tx.Model(&UserSubscription{}).Where("id IN (?)", subscriptions).Update("status", "cancelled").Error; err != nil {
+				return err
+			}
+			if err := rows.Update("status", "revoked").Error; err != nil {
+				return err
+			}
+		} else if receipt.SubscriptionID > 0 {
+			if err := tx.Model(&UserSubscription{}).Where("id = ?", receipt.SubscriptionID).Update("status", "cancelled").Error; err != nil {
+				return err
+			}
+		}
+		if !receipt.Renewable && receipt.Status != "revoked" {
+			if err := updateDaypassKeyReceipt(tx, receipt, "status", "revoked"); err != nil {
+				return err
+			}
+		}
+		return tx.Where(commonKeyCol+" = ?", optionKey).Delete(&Option{}).Error
+	})
+	if err != nil {
+		return err
+	}
+	daypassConcurrencyMutex.Lock()
+	common.OptionMapRWMutex.Lock()
+	delete(common.OptionMap, optionKey)
+	common.OptionMapRWMutex.Unlock()
+	daypassConcurrencyMutex.Unlock()
+	return nil
+}
