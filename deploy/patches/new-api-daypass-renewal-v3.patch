@@ -0,0 +1,64 @@
+package model
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"strconv"
+
+	"github.com/QuantumNous/new-api/common"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+type DaypassShopResult struct {
+	DaypassShopOrder
+	Key        string `json:"key,omitempty"`
+	SKUVersion int    `json:"sku_version,omitempty"`
+	Sub2UserID int64  `json:"sub2_user_id,omitempty"`
+	StartsAt   int64  `json:"starts_at,omitempty"`
+}
+
+func daypassShopResult(row *DaypassShopOrder, input DaypassShopInput, key string) *DaypassShopResult {
+	result := &DaypassShopResult{DaypassShopOrder: *row, Key: key}
+	if input.SKUVersion == DaypassShopRenewalVersion {
+		result.SKUVersion, result.Sub2UserID = DaypassShopRenewalVersion, input.Sub2UserID
+		result.StartsAt = row.RenewalStartsAt
+		if result.StartsAt == 0 {
+			result.StartsAt = row.PaidAt
+		}
+		if row.RenewalTokenID != nil {
+			result.TokenID = row.RenewalTokenID
+		}
+	}
+	return result
+}
+
+func lockDaypassShopOrder(tx *gorm.DB, purchase daypassShopPurchase, now int64) (*DaypassShopOrder, error) {
+	input := purchase.input
+	encoded, err := common.Marshal(input)
+	if err != nil {
+		return nil, err
+	}
+	binding := sha256.Sum256(encoded)
+	row := DaypassShopOrder{
+		ID: daypassShopReceiptID(input.Instance, input.OrderID), Instance: input.Instance, OrderID: input.OrderID,
+		ProductID: input.ProductID, BindingDigest: hex.EncodeToString(binding[:]), PaidAt: input.PaidAt,
+		ExpiresAt: input.PaidAt + purchase.sku.duration, Status: "pending", CreatedAt: now,
+	}
+	if err := tx.Clauses(clause.OnConflict{Columns: []clause.Column{{Name: "id"}}, DoNothing: true}).Create(&row).Error; err != nil {
+		return nil, err
+	}
+	expected := row.BindingDigest
+	if err := lockForUpdate(tx).First(&row, "id = ?", row.ID).Error; err != nil {
+		return nil, err
+	}
+	if row.BindingDigest != expected {
+		return nil, ErrDaypassShopBinding
+	}
+	return &row, nil
+}
+
+func daypassShopReceiptID(instance string, orderID int64) string {
+	identity := sha256.Sum256([]byte(instance + "/" + strconv.FormatInt(orderID, 10)))
+	return hex.EncodeToString(identity[:])
+}
diff --git a/model/daypass_shop_renewal.go b/model/daypass_shop_renewal.go
new file mode 100644
--- /dev/null
+++ b/model/daypass_shop_renewal.go
@@ -0,0 +1,224 @@
+package model
+
+import (
+	"context"
+	"errors"
+	"strconv"
+
+	"github.com/QuantumNous/new-api/common"
+	"gorm.io/gorm"
+)
+
+const DaypassShopRenewalVersion = 3
+
+func provisionDaypassRenewal(ctx context.Context, purchase daypassShopPurchase, now int64) (*DaypassShopResult, error) {
+	daypassConcurrencyMutex.Lock()
+	defer daypassConcurrencyMutex.Unlock()
+	var result *DaypassShopResult
+	var adoptedTokenID int
+	err := DB.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		row, err := lockDaypassShopOrder(tx, purchase, now)
+		if err != nil {
+			return err
+		}
+		if row.Status == "revoked" {
+			return ErrDaypassShopRevoked
+		}
+		if row.ExpiresAt <= now {
+			return ErrDaypassShopExpired
+		}
+		if row.Status == "active" {
+			result, err = replayDaypassRenewalTx(tx, row, purchase.input)
+			return err
+		}
+		if row.Status != "pending" || row.UserID != nil || row.TokenID != nil || row.SubscriptionID != nil || row.RenewalTokenID != nil {
+			return ErrDaypassShopBinding
+		}
+		selection, err := selectDaypassRenewalKeyTx(tx, purchase.input, now)
+		if err != nil {
+			return err
+		}
+		if selection.anchor != nil {
+			adoptedTokenID = *selection.anchor.TokenID
+		}
+		result, err = issueDaypassRenewalTx(tx, row, selection, daypassRenewalPurchase{purchase, now})
+		return err
+	})
+	if err != nil {
+		return nil, err
+	}
+	if adoptedTokenID != 0 {
+		common.OptionMapRWMutex.Lock()
+		delete(common.OptionMap, daypassConcurrencyPrefix+strconv.Itoa(adoptedTokenID))
+		common.OptionMapRWMutex.Unlock()
+	}
+	refreshSubscriptionUserGroupCache(*result.UserID, "day-pass renewal")
+	return result, nil
+}
+
+type daypassRenewalPurchase struct {
+	daypassShopPurchase
+	now int64
+}
+
+func issueDaypassRenewalTx(tx *gorm.DB, row *DaypassShopOrder, selected daypassRenewalSelection, purchase daypassRenewalPurchase) (*DaypassShopResult, error) {
+	input := purchase.input
+	userID, err := daypassRenewalBuyerTx(tx, selected, purchase)
+	if err != nil {
+		return nil, err
+	}
+	starts := input.PaidAt
+	if selected.token != nil {
+		starts = max(starts, selected.token.ExpiredTime)
+	}
+	expires := starts + purchase.sku.duration
+	if expires < starts || expires-input.PaidAt > 10*365*daypassShopDaySecs {
+		return nil, ErrDaypassShopInvalid
+	}
+	spec := daypassGrantSpec{
+		Name: "Sub2 DeepSeek #" + strconv.FormatInt(input.Sub2UserID, 10), Source: "sub2_shop",
+		StartsAt: starts, ExpiresAt: expires, CreatedAt: purchase.now, Renewable: true,
+	}
+	token := selected.token
+	if token == nil {
+		// Version 3 tiers come from the paid windows. A numeric Option on one
+		// of these tokens is an explicit administrator override.
+		token, err = createDaypassTokenTx(tx, userID, spec)
+		if err != nil {
+			return nil, err
+		}
+		row.TokenID = &token.Id
+	} else {
+		if err := adoptDaypassRenewalKeyTx(tx, selected, userID, expires); err != nil {
+			return nil, err
+		}
+	}
+	sub, err := createDaypassSubscriptionTx(tx, userID, spec)
+	if err != nil {
+		return nil, err
+	}
+	row.UserID, row.RenewalTokenID, row.SubscriptionID = &userID, &token.Id, &sub.Id
+	row.RenewalStartsAt, row.RenewalTier, row.ExpiresAt, row.Status = starts, purchase.sku.concurrency, expires, "active"
+	if err := tx.Save(row).Error; err != nil {
+		return nil, err
+	}
+	return daypassShopResult(row, input, "sk-"+token.Key), nil
+}
+
+func daypassRenewalBuyerTx(tx *gorm.DB, selected daypassRenewalSelection, purchase daypassRenewalPurchase) (int, error) {
+	if selected.userID > 0 {
+		return selected.userID, nil
+	}
+	account := daypassSub2Account{UserID: purchase.input.Sub2UserID, Username: purchase.input.Sub2Username}
+	if selected.anchor != nil {
+		userID := *selected.anchor.UserID
+		name := daypassBindingUsername(account.Username)
+		if name == "" {
+			name = "sub2-" + strconv.FormatInt(account.UserID, 10)
+		}
+		binding := DaypassSub2User{Sub2UserID: account.UserID, Username: name, UserID: userID, CreatedAt: purchase.now}
+		if err := tx.Create(&binding).Error; err != nil {
+			return 0, err
+		}
+		return userID, nil
+	}
+	user, err := EnsureDaypassSub2UserTx(tx, account, purchase.now)
+	if err != nil {
+		return 0, err
+	}
+	return user.Id, nil
+}
+
+func replayDaypassRenewalTx(tx *gorm.DB, row *DaypassShopOrder, input DaypassShopInput) (*DaypassShopResult, error) {
+	if row.RenewalTokenID == nil || row.SubscriptionID == nil || row.UserID == nil || row.RenewalStartsAt <= 0 {
+		return nil, ErrDaypassShopBinding
+	}
+	var binding DaypassSub2User
+	if err := tx.First(&binding, "sub2_user_id = ?", input.Sub2UserID).Error; err != nil {
+		return nil, err
+	}
+	if binding.UserID != *row.UserID {
+		return nil, ErrDaypassShopBinding
+	}
+	var token Token
+	if err := tx.First(&token, *row.RenewalTokenID).Error; err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, ErrDaypassShopRevoked
+		}
+		return nil, err
+	}
+	var sub UserSubscription
+	var user User
+	if err := tx.First(&sub, *row.SubscriptionID).Error; err != nil {
+		return nil, err
+	}
+	if err := tx.First(&user, binding.UserID).Error; err != nil {
+		return nil, err
+	}
+	if token.UserId != binding.UserID || sub.UserId != binding.UserID || !isDaypassShopToken(&token) ||
+		token.ExpiredTime < row.ExpiresAt || sub.Source != "sub2_shop" || sub.PlanId != 1 || sub.AmountTotal != 0 ||
+		sub.AllowWalletOverflow || sub.StartTime != row.RenewalStartsAt || sub.EndTime != row.ExpiresAt {
+		return nil, ErrDaypassShopBinding
+	}
+	if token.Status != common.TokenStatusEnabled || user.Status != common.UserStatusEnabled || sub.Status != "active" {
+		return nil, ErrDaypassShopRevoked
+	}
+	return daypassShopResult(row, input, "sk-"+token.Key), nil
+}
+
+func isDaypassShopToken(token *Token) bool {
+	return token.Group == "daypass" && token.ModelLimitsEnabled && token.ModelLimits == DaypassModelPolicy &&
+		token.UnlimitedQuota && !token.CrossGroupRetry && !token.AllowUserQuotaQuery && token.ExpiredTime > 0
+}
+
+func adoptDaypassRenewalKeyTx(tx *gorm.DB, selected daypassRenewalSelection, userID int, expires int64) error {
+	token := selected.token
+	if err := invalidateTokenCacheForMutation(token.Key); err != nil {
+		return err
+	}
+	if anchor := selected.anchor; anchor != nil {
+		sub := selected.legacySub
+		if sub.UserId != userID {
+			// The native subscription ID stays unchanged for historical
+			// usage/settlement; only its linked buyer becomes canonical.
+			// Keep the native expiry worker's subscription-before-user order.
+			if err := lockForUpdate(tx).First(sub, sub.Id).Error; err != nil {
+				return err
+			}
+			if sub.Status == "cancelled" {
+				return ErrDaypassShopRevoked
+			}
+			if err := tx.Model(sub).Update("user_id", userID).Error; err != nil {
+				return err
+			}
+		}
+		anchor.UserID, anchor.RenewalTokenID = &userID, &token.Id
+		anchor.RenewalStartsAt, anchor.RenewalTier = sub.StartTime, GetDaypassTokenConcurrency(token.Id)
+		if err := tx.Save(anchor).Error; err != nil {
+			return err
+		}
+		if err := tx.Where(commonKeyCol+" = ?", daypassConcurrencyPrefix+strconv.Itoa(token.Id)).Delete(&Option{}).Error; err != nil {
+			return err
+		}
+	}
+	return tx.Unscoped().Model(token).Updates(map[string]any{
+		"user_id": userID, "expired_time": expires, "status": common.TokenStatusEnabled, "deleted_at": nil,
+	}).Error
+}
+
+func reconcileDaypassShopKeyTx(tx *gorm.DB, tokenID int) error {
+	var token Token
+	found, err := daypassFind(tx.Where("id = ?", tokenID), &token)
+	if err != nil || !found {
+		return err
+	}
+	var expiry struct{ ExpiresAt int64 }
+	if err := tx.Model(&DaypassShopOrder{}).Select("COALESCE(MAX(expires_at), 0) AS expires_at").
+		Where("renewal_token_id = ? AND status = ?", tokenID, "active").Scan(&expiry).Error; err != nil {
+		return err
+	}
+	if err := invalidateTokenCacheForMutation(token.Key); err != nil {
+		return err
+	}
+	return tx.Model(&token).Update("expired_time", max(expiry.ExpiresAt, 1)).Error
+}
diff --git a/model/daypass_shop_renewal_test.go b/model/daypass_shop_renewal_test.go
