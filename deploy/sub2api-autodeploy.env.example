# This file is installed as /etc/sub2api-autodeploy.env.  Values below are
# examples only; install-autodeploy.sh derives repository URLs and the current
# production branch from the checked-out source by default.
SUB2API_APP_DIR=/opt/sub2api

# Source branch used only by the recovery service. The normal production path
# builds the exact main commit in GitHub Actions and does not fetch source here.
SUB2API_AUTODEPLOY_PRODUCTION_REMOTE=fork
SUB2API_AUTODEPLOY_PRODUCTION_REPO_URL=https://github.com/Turtle-Li/sub2api.git
SUB2API_AUTODEPLOY_PRODUCTION_BRANCH=main

# Recovery-mode merge settings. Ordinary pushes and tags do not start a
# production workflow or a server-side release.
SUB2API_AUTODEPLOY_MERGE_MAIN=false
SUB2API_AUTODEPLOY_MAIN_REMOTE=fork
SUB2API_AUTODEPLOY_MAIN_REPO_URL=https://github.com/Turtle-Li/sub2api.git
SUB2API_AUTODEPLOY_MAIN_BRANCH=main

# Official upstream changes are intentionally merged into fork/main by a
# maintainer first. The server never deploys an upstream update on its own.
SUB2API_AUTODEPLOY_MERGE_UPSTREAM=false
SUB2API_AUTODEPLOY_UPSTREAM_REMOTE=origin
SUB2API_AUTODEPLOY_UPSTREAM_REPO_URL=https://github.com/Wei-Shaw/sub2api.git
SUB2API_AUTODEPLOY_UPSTREAM_BRANCH=main

# The image receiver requires the canonical GitHub source label and rejects
# compressed uploads larger than this hard limit.
SUB2API_GITHUB_IMAGE_SOURCE=https://github.com/Turtle-Li/sub2api
SUB2API_GITHUB_IMAGE_MAX_BYTES=1073741824

SUB2API_PUBLIC_HEALTH_URL=https://www.turtleligpt.com/health
# Production releases, database cutovers, and runtime recovery must all hold
# this root-owned 0600 file below its root-owned 0700 private parent before
# changing an application container or Caddy upstream.
SUB2API_MAINTENANCE_LOCK_FILE=/run/sub2api-maintenance/sub2api-maintenance.lock
# Runtime recovery waits up to one minute per health gate, retries failed
# dependencies once, and rate-limits repeated fallback attempts for five
# minutes. The systemd timer itself runs every 30 seconds.
SUB2API_RUNTIME_GUARD_RETRY_ATTEMPTS=20
SUB2API_RUNTIME_GUARD_RETRY_INTERVAL_SECONDS=3
SUB2API_RUNTIME_GUARD_COOLDOWN_SECONDS=300
SUB2API_RUNTIME_GUARD_PUBLIC_HEALTH_ATTEMPTS=3
SUB2API_RUNTIME_GUARD_PUBLIC_HEALTH_INTERVAL_SECONDS=3
SUB2API_RUNTIME_GUARD_PUBLIC_HEALTH_MAX_TIME_SECONDS=20
SUB2API_AUTODEPLOY_LOCK_WAIT_SECONDS=900
SUB2API_AUTODEPLOY_FAILURE_RETRY_SECONDS=1800
# Fail closed if a previous inactive app container is still running. Even a
# container with no Caddy traffic can consume shared background queues.
SUB2API_RELEASE_ALLOW_PREEXISTING_DRAINING_CONTAINER=false
# Default releases activate the selected generation as this node's background
# owner. Use preserve-standby only on a dual-node request-serving rollback or
# canary node that is already background=standby; the release transaction then
# keeps both the old and new generations fenced throughout switch and recovery.
SUB2API_RELEASE_BACKGROUND_MODE=activate
# Migration-only application override. Keep preserve for ordinary releases;
# use true for the fixed-egress compatibility rollout and false for the
# reviewed fence-enabling release of the same image.
SUB2API_RELEASE_FIXED_EGRESS_COMPATIBILITY_MODE=preserve
