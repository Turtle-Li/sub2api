[Unit]
Description=Sub2API Aliyun ImageEnhan host credential agent
After=docker.service
RequiresMountsFor=/var/lib/docker/volumes/sub2api_image_upscale_vault/_data/aliyun
ConditionPathExists=/etc/sub2api-credentials/sub2api-aliyun-image-upscale.cred

[Service]
Type=notify
NotifyAccess=all
User=1000
Group=1000
UMask=0077
RuntimeDirectory=sub2api-aliyun-agent
RuntimeDirectoryMode=0700
BindPaths=/var/lib/docker/volumes/sub2api_image_upscale_vault/_data/aliyun:/run/sub2api-aliyun-agent/public
LoadCredentialEncrypted=sub2api-aliyun-image-upscale:/etc/sub2api-credentials/sub2api-aliyun-image-upscale.cred
ExecStart=/usr/local/libexec/sub2api-image-upscale-aliyun/host-load
TimeoutStartSec=25
Restart=on-failure
RestartSec=5s
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateNetwork=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
